<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <!-- iisnode: executa o backend CBMAM Chamados -->
    <handlers>
      <add name="iisnode" path="backend/src/iisentry.cjs" verb="*" modules="iisnode" />
    </handlers>

    <rewrite>
      <rules>
        <!-- Tudo passa pelo Express/Node.js (API + SPA + arquivos estáticos) -->
        <rule name="NodeApp" stopProcessing="true">
          <match url=".*" />
          <action type="Rewrite" url="backend/src/iisentry.cjs" />
        </rule>
      </rules>
    </rewrite>

    <!-- iisnode: configurações válidas do schema iisnode -->
    <iisnode
      nodeProcessCommandLine="C:\PROGRA~1\nodejs\node.exe"
      loggingEnabled="true"
      logDirectory="logs\iisnode"
      debuggingEnabled="false"
      flushResponse="false"
      enableXFF="true"
      devErrorsEnabled="false"
      maxConcurrentRequestsPerProcess="1024"
      gracefulShutdownTimeout="60000"
      watchedFiles="web.config;iisentry.cjs"
      recycleOnFileChange="true"
    />

    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="104857600" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
