# CBMAM Chamados Backend — Exemplo de variáveis de ambiente
# Copie este arquivo para .env no servidor e preencha com os valores reais do Plesk.

PORT=4000

# Chave secreta do JWT (Gere uma chave forte, ex: openssl rand -base64 48)
JWT_SECRET=troque-esta-chave-em-producao

# Banco de Dados MySQL do Plesk
DB_HOST=localhost
DB_PORT=3306
DB_USER=cilomi
DB_PASS=c06zi09@Z
DB_NAME=bm6_chamados

# API Externa de Autenticação (DRH / SIGDP)
SIGDP_API_URL=https://www.cbm.am.gov.br/sigdp/api/login
SIGDP_API_FALLBACK_URL=https://drhsistema-production.up.railway.app/api/login

# Configurações de Envio de E-mail (SMTP)
SMTP_HOST=smtp.exemplo.com
SMTP_PORT=587
SMTP_USER=chamados@cbmam.am.gov.br
SMTP_PASS=sua_senha_app
SMTP_SECURE=false
SMTP_FROM=chamados@cbmam.am.gov.br

# Origem do Frontend
FRONTEND_URL=https://chamados.cbm.am.gov.br
